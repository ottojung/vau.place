<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>tshirt43</title>
<style>
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}
body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
#stage{position:fixed;inset:0;display:grid;place-items:center;overflow:hidden;background:#000}
#squidward{display:block;width:100vw;height:100vh;object-fit:contain;transform:scale(2.45);transform-origin:57% 68%;transition:transform .28s ease;cursor:zoom-out;user-select:none;-webkit-user-drag:none}
body.zoomed-out #squidward{transform:scale(1);cursor:zoom-in}
#toggle{position:fixed;right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));z-index:2;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:.62rem .9rem;background:rgba(0,0,0,.68);color:#fff;font:600 14px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);cursor:pointer}
#toggle:focus-visible{outline:2px solid #fff;outline-offset:2px}
</style>
</head>
<body>
<div id="stage" aria-label="Squidward image, zoomed in on the chest by default">
  <img id="squidward" alt="Squidward posing with hands on hips" src="data:image/jpeg;base64,">
</div>
<button id="toggle" type="button" aria-pressed="false">Zoom out</button>
<script>
const body=document.body;
const stage=document.getElementById("stage");
const button=document.getElementById("toggle");
let zoomed=true;
function render(){
  body.classList.toggle("zoomed-out",!zoomed);
  button.textContent=zoomed?"Zoom out":"Zoom in";
  button.setAttribute("aria-pressed",String(!zoomed));
}
function toggle(){zoomed=!zoomed;render()}
stage.addEventListener("click",toggle);
button.addEventListener("click",e=>{e.stopPropagation();toggle()});
document.addEventListener("keydown",e=>{
  if(e.key==="Enter"||e.key===" "){e.preventDefault();toggle()}
});
</script>
</body>
</html>